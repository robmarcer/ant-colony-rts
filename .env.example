# Copy to .env and fill in. The key is only ever read by the node server,
# never shipped to the browser.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: default model used when the UI does not override it
ANT_DEFAULT_MODEL=claude-sonnet-5
# Port for the local API (not PORT, which dev harnesses may set for vite)
ANT_API_PORT=8787
